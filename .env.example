# .env.example

# Lama inpainting environment overrides
# LAMA_VENV_PATH="path/to/lama/venv"
# LAMA_REPO_ROOT="path/to/lama"

# Optional experimental R014 ResNet-34 segmenter checkpoint
# Note: The R014 checkpoint is NOT included in the git repository due to its size.
# You must download it separately and place it in the path below, or update this variable.
R014_SEGMENTER_CHECKPOINT="checkpoints/segmenter/seg-unet-resnet34-r014-s42/best_val_iou.pth"
